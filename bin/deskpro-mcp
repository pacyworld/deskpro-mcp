#!/usr/bin/env php
<?php
/**
 * Deskpro MCP Server - stdio Entry Point
 *
 * Deskpro helpdesk management via the Model Context Protocol.
 * Communicates over stdin/stdout using JSON-RPC 2.0.
 *
 * Usage:
 *   php bin/deskpro-mcp
 *
 * Environment:
 *   DESKPRO_CONFIG          Path to deskpro.json configuration file
 *   DESKPRO_MCP_LOG         Path to a log file (enables durable file logging)
 *   DESKPRO_MCP_LOG_LEVEL   debug|info|error (default: debug when a log file is set)
 *   DESKPRO_MCP_LOG_STDERR  Mirror log lines to STDERR (default: off; set to 1 to enable)
 *   DESKPRO_MCP_IO_MODE     auto|reactor|blocking (default: auto)
 *
 * CLI flags:
 *   --config=PATH      Path to deskpro.json
 *   --log=PATH         Log file path (overrides DESKPRO_MCP_LOG)
 *   --log-level=LEVEL  debug|info|error
 *   --io-mode=MODE     auto|reactor|blocking (transport I/O strategy)
 *
 * @package    DeskproMCP
 * @author     Daniel Morante
 * @copyright  2026 The Daniel Morante Company, Inc.
 * @license    BSD-2-Clause
 */

// Enchilada Framework bootstrap
require_once dirname(__DIR__) . '/system/bootstrap.inc.php';

use EnchiladaMCP\Logger;
use DeskproMCP\InstanceManager;

// --- Configuration ---

$configPath = getenv('DESKPRO_CONFIG') ?: null;
$logPath = getenv('DESKPRO_MCP_LOG') ?: null;
$logLevel = getenv('DESKPRO_MCP_LOG_LEVEL') ?: 'debug';
// Stderr mirroring is opt-in. stdout is the protocol channel and stderr
// is only as reliable as the host's willingness to drain it: a host that
// captures stderr and never reads it will fill the pipe and stall the
// server (observed on Windows, where the stream cannot be made
// non-blocking). The log file is the durable diagnostic channel.
$stderrEnv = getenv('DESKPRO_MCP_LOG_STDERR');
$logStderr = ($stderrEnv === false) ? false : (bool)$stderrEnv;
$ioMode = getenv('DESKPRO_MCP_IO_MODE') ?: null;

// Check CLI arguments: --config=/path/to/deskpro.json, --log=/path/to/file, --log-level=debug
foreach ($argv ?? [] as $arg) {
    if (str_starts_with($arg, '--config=')) {
        $configPath = substr($arg, 9);
    }
    if (str_starts_with($arg, '--log=')) {
        $logPath = substr($arg, 6);
    }
    if (str_starts_with($arg, '--log-level=')) {
        $logLevel = substr($arg, 12);
    }
    if (str_starts_with($arg, '--io-mode=')) {
        $ioMode = substr($arg, 10);
    }
}

$logLevelValue = Logger::levelFromString($logLevel) ?? Logger::LEVEL_DEBUG;
$logger = new Logger($logPath, $logLevelValue, $logStderr, APPLICATION_SLUG);

// Default config location
if ($configPath === null) {
    $candidates = [
        APPLICATION_CONFDIR . 'deskpro.json',
        getenv('HOME') . '/.config/deskpro-mcp/deskpro.json',
        '/usr/local/etc/deskpro-mcp/deskpro.json',
    ];
    foreach ($candidates as $candidate) {
        if (file_exists($candidate)) {
            $configPath = $candidate;
            break;
        }
    }
}

if ($configPath === null || !file_exists($configPath)) {
    fwrite(STDERR, "[deskpro-mcp] ERROR: No configuration file found.\n");
    fwrite(STDERR, "  Set DESKPRO_CONFIG environment variable or use --config=/path/to/deskpro.json\n");
    fwrite(STDERR, "  Or place deskpro.json in config/ directory.\n");
    exit(1);
}

// --- Bootstrap ---

if ($logPath !== null && @file_put_contents($logPath, '', FILE_APPEND) === false) {
    fwrite(STDERR, "[deskpro-mcp] WARNING: Log file not writable: {$logPath}\n");
    $logger = new Logger(null, $logLevelValue, $logStderr, APPLICATION_SLUG);
}

$logger->info(APPLICATION_NAME . ' ' . APPLICATION_VERSION . " starting (pid " . getmypid() . ", php " . PHP_VERSION . ')');
$logger->info("Log file: " . ($logPath ?? '(disabled — set DESKPRO_MCP_LOG to enable)'));

try {
    $manager = InstanceManager::fromFile($configPath);
} catch (\Exception $e) {
    fwrite(STDERR, "[deskpro-mcp] ERROR: " . $e->getMessage() . "\n");
    $logger->error('Configuration load failed: ' . $e->getMessage());
    exit(1);
}

$instanceCount = $manager->count();
$logger->info("Loaded {$instanceCount} instance(s) from {$configPath} (default: {$manager->getDefault()})");

// Log per-instance auth info
foreach ($manager->listInstances() as $name => $info) {
    $marker = $info['is_default'] ? ' [default]' : '';
    $logger->info("  {$name}: {$info['auth_method']}{$marker}");
}

// --- Create MCP Server ---

$server = new \EnchiladaMCP\McpServer(APPLICATION_SLUG, APPLICATION_VERSION);
$server->setLogger($logger);

$server->setInstructions(
    'Deskpro MCP server for helpdesk ticket management. '
    . 'Use deskpro_help for setup guidance, deskpro_tool_categories to explore available tools. '
    . 'All tools accept an optional instance parameter for multi-site configurations.'
);

// Register tools
$server->register(new \InstanceTools($manager));
$logger->debug("Registered tools: InstanceTools");

$server->register(new \TicketTools($manager));
$logger->debug("Registered tools: TicketTools");

$server->register(new \TicketActionTools($manager));
$logger->debug("Registered tools: TicketActionTools");

$server->register(new \LookupTools($manager));
$logger->debug("Registered tools: LookupTools");

$server->register(new \MetaTools($manager, APPLICATION_VERSION));
$logger->debug("Registered tools: MetaTools");

// --- Transport ---

// The application owns the event loop (strict opt-in): shared with
// the stdio transport (reactor I/O) and the tools' HTTP path, where
// Tortilla\HttpClient parks the dispatch fiber on it during Deskpro
// API waits. null without vendored Comal: blocking I/O, progress flow
// via the HttpClient poll loop.
$loop = \Enchilada\Tortilla\ComalEventLoop::create();
$manager->setHttpTransport($loop, $server->tick(...));

// Primitives in (handler, progress emitter), notifier back out —
// only the composition root knows both sides of the contract.
$transport = new \Enchilada\Tortilla\StdioTransport($server->handleRequest(...), $server->tick(...));
$transport->setLogger($logger);
if ($loop !== null) {
    $transport->setLoop($loop);      // opts into reactor I/O
}
$server->setNotifier($transport->sendNotification(...));

// I/O mode override and diagnostics land on the logger, never stdout.
if ($ioMode !== null) {
    try {
        $transport->setIoMode($ioMode);
    } catch (\InvalidArgumentException $e) {
        fwrite(STDERR, "[deskpro-mcp] ERROR: " . $e->getMessage() . "\n");
        exit(1);
    }
}

// Enter event loop
$transport->run();

$logger->info("MCP server stopped");
